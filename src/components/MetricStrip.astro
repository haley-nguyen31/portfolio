---
interface Props { metrics: { value: string; label: string }[] }
const { metrics } = Astro.props;
// "40+" -> count to 40 with suffix "+"; non-numeric values (e.g. "Silver") stay static.
const parse = (v: string) => {
  const m = v.match(/^(\d[\d,]*)(.*)$/);
  return m ? { n: m[1].replace(/,/g, ''), suffix: m[2] } : null;
};
---
<section aria-label="Key numbers" class="border-b border-line bg-surface">
  <div class="h-0.5" style="background: var(--gradient)" aria-hidden="true"></div>
  <div data-reveal-group class="mx-auto grid max-w-[1200px] grid-cols-[repeat(auto-fit,minmax(180px,1fr))]">
    {metrics.map((m) => {
      const p = parse(m.value);
      return (
        <div class="flex flex-col gap-2 border-r border-line px-6 py-8">
          <div class="font-serif text-[44px] leading-none tracking-[-0.01em]" {...(p ? { 'data-count': p.n, 'data-suffix': p.suffix } : {})}>{m.value}</div>
          <div class="font-mono text-[11.5px] uppercase leading-normal tracking-[0.06em] text-muted">{m.label}</div>
        </div>
      );
    })}
  </div>
</section>
