---
import { getImage } from 'astro:assets';
import Img from './Img.astro';
import { getImg } from '../lib/images';

interface Item { name: string; alt: string; caption?: string }
interface Props { items: Item[]; group: string; class?: string; sizes?: string }
const { items, group, class: cls = 'grid-cols-2 md:grid-cols-3', sizes = '(min-width:768px) 33vw, 50vw' } = Astro.props;

const resolved = await Promise.all(
  items.map(async (it) => {
    const meta = getImg(it.name);
    if (!meta) return null;
    const full = await getImage({ src: meta, width: Math.min(meta.width, 1600), format: 'webp' });
    return { ...it, full: full.src };
  }),
);
---
<ul class:list={['m-0 grid list-none gap-3 p-0', cls]}>
  {resolved.filter(Boolean).map((it) => (
    <li>
      <button type="button" class="lightbox-trigger group block w-full cursor-zoom-in overflow-hidden rounded-xl border border-line bg-surface"
        data-group={group} data-full={it!.full} data-alt={it!.alt} data-caption={it!.caption ?? ''} aria-label={`Enlarge image: ${it!.alt}`}>
        <Img name={it!.name} alt={it!.alt} sizes={sizes} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]" />
      </button>
      {it!.caption && <p class="m-0 mt-2 text-[13px] leading-snug text-muted">{it!.caption}</p>}
    </li>
  ))}
</ul>
