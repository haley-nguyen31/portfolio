---
interface Props { lines: { cmd: string; out: string[] }[]; title?: string }
const { lines, title = '' } = Astro.props;
---
<div class="min-w-0 overflow-hidden rounded-2xl border border-line bg-surface shadow-[0_24px_60px_-30px_rgba(17,17,20,0.25)]" role="group" aria-label="About me, in terminal form">
  <div class="flex items-center gap-2 border-b border-line px-[18px] py-3.5">
    <span class="inline-block h-2.5 w-2.5 rounded-full bg-line" aria-hidden="true"></span>
    <span class="inline-block h-2.5 w-2.5 rounded-full bg-line" aria-hidden="true"></span>
    <span class="inline-block h-2.5 w-2.5 rounded-full bg-line" aria-hidden="true"></span>
    {title && <span class="ml-2 font-mono text-xs text-muted">{title}</span>}
  </div>
  <div class="px-[22px] pb-[26px] pt-[22px] font-mono text-[13.5px] leading-[1.9] text-body">
    {lines.map((l, i) => (
      <div class:list={[i > 0 && 'mt-2.5']}>
        <div><span class="text-accent" aria-hidden="true">❯</span> {l.cmd}</div>
        {l.out.map((o) => <div class="text-ink">{o}</div>)}
      </div>
    ))}
  </div>
</div>
