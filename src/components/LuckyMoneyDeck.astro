---
import Img from './Img.astro';
import PullQuote from './PullQuote.astro';

interface Props { deck: any }
const { deck: d } = Astro.props;

const slides = ['Cover', 'Overview', 'Roll-out', 'Phase 1 · Activities', 'Phase 1 · Digital ads', 'Phase 2 · Out-app', 'In-app', 'Inspirations'];
const total = String(slides.length).padStart(2, '0');
const no = (i: number) => `${String(i + 1).padStart(2, '0')} / ${total}`;
const tone: Record<string, string> = { green: 'bg-[#E6F6EC] text-[#14663A] border-[#BFE5CD]', blue: 'bg-[#E8F0FF] text-[#1E3FA8] border-[#C5D7FB]', red: 'bg-[#FDE9E7] text-[#A5281B] border-[#F5C3BE]' };
const card = 'rounded-2xl border border-line bg-surface p-5 sm:p-7';
const head = 'mb-5 flex items-center justify-between gap-3 font-mono text-[11px] uppercase tracking-[0.08em] text-muted';
---
<div class="flex flex-col gap-6" data-deck>
  <!-- 01 Cover -->
  <section class="relative overflow-hidden rounded-2xl bg-[#0b0b0d] p-6 text-bg sm:p-10" aria-label={slides[0]}>
    <div class="relative z-10 flex flex-wrap items-center justify-between gap-8">
      <div class="flex max-w-md flex-col gap-4">
        <div class="font-mono text-[11px] uppercase tracking-[0.08em] text-footer-accent">{d.cover.kicker}</div>
        <h3 class="m-0 font-serif text-[clamp(40px,6vw,64px)] font-normal leading-none">{d.cover.title}</h3>
        <p class="m-0 font-mono text-sm text-[#A3A3AD]">{d.cover.subtitle}</p>
        <div class="font-mono text-[11px] text-[#9a9aa5]">{no(0)}</div>
      </div>
      <div class="flex items-end gap-2">
        <Img name={d.cover.images.phone} alt="Lucky Money Tree in the Zalopay app" widths={[240, 408]} sizes="200px" class="h-auto w-[120px] sm:w-[180px]" />
        <Img name={d.cover.images.horse} alt="Lucky horse on a cloud carrying red envelopes" widths={[240, 500]} sizes="220px" class="h-auto w-[140px] sm:w-[220px]" />
      </div>
    </div>
  </section>

  <!-- 02 Overview -->
  <section class={card} aria-label={slides[1]}>
    <div class={head}><span>Project overview</span><span>{no(1)}</span></div>
    <div class="grid gap-8 lg:grid-cols-[260px_1fr]">
      <figure class="m-0 mx-auto w-full max-w-[260px] overflow-hidden rounded-2xl border border-line bg-cover p-1.5 lg:sticky lg:top-24 lg:self-start">
        <Img name={d.overview.image} alt="The Lucky Money Tree screen in Zalopay" widths={[260, 520]} sizes="260px" class="h-auto w-full rounded-xl" />
      </figure>
      <div class="flex flex-col gap-7">
        <p class="m-0 font-serif text-[clamp(22px,2.6vw,30px)] leading-snug text-ink">{d.overview.statement}</p>
        <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
          {d.overview.envelopes.map((e: any) => <li class:list={['rounded-full border px-3.5 py-1.5 font-mono text-xs', tone[e.tone]]}>{e.name}</li>)}
        </ul>
        <div>
          <div class="mono-label mb-3">KEY MILESTONES</div>
          <dl class="m-0 divide-y divide-line border-y border-line">
            {d.overview.milestones.map((m: any) => (
              <div class="grid gap-1 py-3.5 sm:grid-cols-[170px_1fr] sm:gap-6">
                <dt class="font-mono text-xs uppercase tracking-wide text-muted">{m.label}</dt>
                <dd class="m-0 text-[15.5px] leading-relaxed text-body"><strong class="font-mono text-[0.92em] font-medium text-ink">{m.value}</strong> · {m.text}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div>
          <div class="mono-label mb-3">KEY OBJECTIVES</div>
          <div class="grid gap-3 sm:grid-cols-2">
            {d.overview.objectives.map((o: any, i: number) => (
              <div class="rounded-xl border border-line bg-bg p-4">
                <div class="mb-2 font-mono text-xs text-accent">0{i + 1}</div>
                <h4 class="m-0 mb-2 text-base font-semibold text-ink">{o.title}</h4>
                <ul class="m-0 flex list-disc flex-col gap-1.5 pl-5 text-[14.5px] leading-relaxed text-body marker:text-accent">{o.points.map((p: string) => <li>{p}</li>)}</ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Roadmap -->
  <section class={card} aria-label={slides[2]}>
    <div class={head}><span>Roll-out plan</span><span>{no(2)}</span></div>
    <ol class="m-0 grid list-none gap-4 p-0 md:grid-cols-2">
      {d.roadmap.phases.map((p: any) => (
        <li class="relative overflow-hidden rounded-xl bg-ink p-6 text-bg">
          <div class="font-mono text-xs text-footer-accent">PHASE {p.id}</div>
          <div class="mt-1 font-serif text-[40px] leading-none">{p.name}</div>
          <div class="mt-3 font-mono text-sm text-[#d7d7de]">{p.dates}</div>
          <div class="mt-4 border-t border-[#3A3A42] pt-3 text-[15px] text-[#d7d7de]">{p.goal}</div>
        </li>
      ))}
    </ol>
  </section>

  <!-- 04 Phase 1 activities -->
  <section class={card} aria-label={slides[3]}>
    <div class={head}><span>Phase 1 · Teasing (1 – 16 Feb)</span><span>{no(3)}</span></div>
    <div class="flex flex-col gap-5">
      {d.activities.map((a: any) => (
        <article class="grid gap-6 rounded-xl border border-line bg-bg p-5 md:grid-cols-[1fr_240px]">
          <div class="flex flex-col gap-3">
            <div class="flex flex-wrap items-center gap-2.5 font-mono text-xs">
              <span class="text-accent">ACTIVITY {a.num}</span><span class="rounded-md bg-chip px-2 py-1 text-chip-text">{a.type}</span>
            </div>
            <h4 class="m-0 font-serif text-[28px] font-normal leading-tight text-ink">{a.title}</h4>
            <p class="m-0 text-[15.5px] italic leading-relaxed text-body">{a.lead}</p>
            <p class="m-0 text-[15px] leading-relaxed text-body"><strong class="font-mono text-xs font-medium uppercase tracking-wide text-muted">Objective · </strong>{a.objective}</p>
            {a.facts.length > 0 && <ul class="m-0 flex list-none flex-wrap gap-2 p-0">{a.facts.map((f: string) => <li class="rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs text-body">{f}</li>)}</ul>}
            <ol class="m-0 flex list-none flex-col gap-2 p-0 text-[14.5px] leading-relaxed text-body">
              {a.steps.map((s: string, i: number) => <li class="flex gap-3"><span class="font-mono text-xs leading-[1.9] text-accent">{i + 1}.</span><span>{s}</span></li>)}
            </ol>
            {a.why && <PullQuote>{a.why}</PullQuote>}
          </div>
          {a.image && (
            <div class="flex items-center justify-center overflow-hidden rounded-xl bg-black">
              <Img name={a.image} alt="Mã Lẹ, the Zalopay horse mascot, carrying a red envelope with a QR code" widths={[240, 480]} sizes="240px" class="h-auto w-full object-contain" />
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- 05 Digital ads -->
  <section class={card} aria-label={slides[4]}>
    <div class={head}><span>{d.ads.title}</span><span>{no(4)}</span></div>
    <p class="m-0 mb-6 text-[15.5px] leading-relaxed text-body"><strong class="font-mono text-xs font-medium uppercase tracking-wide text-muted">Focus · </strong>{d.ads.focus}</p>
    <div class="grid gap-4 md:grid-cols-3">
      {d.ads.channels.map((c: any) => (
        <div class="flex flex-col gap-3 rounded-xl border border-line bg-bg p-4">
          <h4 class="m-0 font-mono text-sm font-medium text-ink">{c.name}</h4>
          {c.blocks.map((b: any) => (
            <div class="flex flex-col gap-1 border-t border-line pt-3">
              <div class="flex items-baseline justify-between gap-3"><span class="text-sm font-semibold text-ink">{b.label}</span><span class="shrink-0 font-mono text-xs text-accent">{b.volume}</span></div>
              <p class="m-0 text-[13.5px] leading-relaxed text-body">{b.detail}</p>
            </div>
          ))}
        </div>
      ))}
    </div>
    <div class="mt-6">
      <div class="mono-label mb-3">CONTENT ALLOCATION</div>
      <div class="flex h-9 overflow-hidden rounded-lg border border-line" role="img" aria-label={d.ads.allocation.map((a: any) => `${a.label} ${a.pct}%`).join(', ')}>
        {d.ads.allocation.map((a: any, i: number) => <div style={`width:${a.pct}%`} class:list={['flex items-center justify-center font-mono text-xs', i === 2 ? 'bg-ink text-bg' : i === 1 ? 'bg-chip text-chip-text' : 'bg-cover text-body']}>{a.pct}%</div>)}
      </div>
      <ul class="m-0 mt-3 flex list-none flex-col gap-1 p-0 text-[13.5px] text-body">{d.ads.allocation.map((a: any) => <li><span class="font-mono text-xs text-muted">{a.pct}% · </span>{a.label}</li>)}</ul>
    </div>
  </section>

  <!-- 06 Out-app -->
  <section class={card} aria-label={slides[5]}>
    <div class={head}><span>{d.outApp.title}</span><span>{no(5)}</span></div>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[560px] border-collapse text-left text-sm">
        <thead><tr><th class="w-32 p-2" scope="col"><span class="sr-only">Channel</span></th>{d.outApp.groups.map((g: string) => <th scope="col" class="rounded-t-lg bg-ink p-3 font-mono text-xs font-medium text-bg">{g}</th>)}</tr></thead>
        <tbody>
          <tr class="align-top">
            <th scope="row" class="p-3 text-left font-mono text-xs font-medium text-ink">Facebook groups</th>
            {d.outApp.themes.map((t: string) => <td class="border border-line bg-bg p-3 leading-relaxed text-body">{t}</td>)}
          </tr>
          {d.outApp.channels.map((c: any) => (
            <tr>
              <th scope="row" class="p-3 text-left font-mono text-xs font-medium text-ink">{c.name}</th>
              {c.volumes.map((v: string) => <td class="border border-line p-3 font-mono text-[13px] text-accent">{v}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="m-0 mt-4 text-[14.5px] leading-relaxed text-body">{d.outApp.note} {d.outApp.totals}</p>
    <p class="m-0 mt-2 text-[14.5px] leading-relaxed text-muted">{d.outApp.production}</p>
  </section>

  <!-- 07 In-app -->
  <section class={card} aria-label={slides[6]}>
    <div class={head}><span>{d.inApp.title}</span><span>{no(6)}</span></div>
    <ol class="m-0 grid list-none gap-3 p-0 sm:grid-cols-3">
      {d.inApp.periods.map((p: any, i: number) => (
        <li class:list={['rounded-xl border p-4', i === 2 ? 'border-ink bg-ink text-bg' : 'border-line bg-bg']}>
          <div class:list={['font-mono text-xs', i === 2 ? 'text-footer-accent' : 'text-muted']}>{p.dates}</div>
          <div class="text-lg font-semibold">{p.label}</div>
        </li>
      ))}
    </ol>
    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      <div>
        <div class="mono-label mb-3">IN-APP BANNERS</div>
        <ul class="m-0 flex list-none flex-col gap-3 p-0">{d.inApp.banners.map((b: any) => <li class="rounded-xl border border-line bg-bg p-4 text-[14.5px] leading-relaxed text-body"><strong class="font-mono text-xs font-medium text-accent">{b.when.toUpperCase()} · </strong>{b.text}</li>)}</ul>
        <div class="mono-label mb-3 mt-6">NBA</div>
        <p class="m-0 text-[14.5px] leading-relaxed text-body">{d.inApp.nba}</p>
      </div>
      <div>
        <div class="mono-label mb-3">NOTIFICATIONS</div>
        <p class="m-0 mb-4 text-[14.5px] leading-relaxed text-body">{d.inApp.noti.audience}</p>
        <ol class="m-0 flex list-none flex-col gap-0 p-0">
          {d.inApp.noti.steps.map((s: string, i: number) => <li class="flex gap-3 border-t border-line py-2.5 text-[14.5px] text-body"><span class="font-mono text-xs leading-[1.7] text-accent">0{i + 1}</span>{s}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <!-- 08 Research -->
  <section class={card} aria-label={slides[7]}>
    <div class={head}><span>{d.research.title}</span><span>{no(7)}</span></div>
    <div class="grid gap-5 md:grid-cols-2">
      {d.research.cards.map((c: any) => (
        <article class="flex flex-col gap-4 rounded-xl border border-line bg-bg p-5">
          <div><h4 class="m-0 text-lg font-semibold text-ink">{c.title}</h4><div class="font-mono text-xs text-muted">{c.subtitle}</div></div>
          <dl class="m-0 flex flex-col gap-3">{c.points.map((p: any) => <div><dt class="font-mono text-xs uppercase tracking-wide text-accent">{p.k}</dt><dd class="m-0 mt-0.5 text-[14.5px] leading-relaxed text-body">{p.v}</dd></div>)}</dl>
          <Img name={c.image} alt={c.alt} widths={[400, 800]} sizes="(min-width:768px) 40vw, 90vw" class="mt-auto h-auto w-full rounded-lg border border-line" />
        </article>
      ))}
    </div>
  </section>
</div>
