---
interface Props { value: string; label: string }
const { value, label } = Astro.props;
---
<div class="flex flex-col gap-1.5 rounded-xl border border-line bg-surface px-4 py-3.5">
  <div class="font-mono text-[22px] font-medium leading-none tracking-tight text-accent">{value}</div>
  <div class="font-mono text-[11px] uppercase leading-snug tracking-[0.06em] text-muted">{label}</div>
</div>
