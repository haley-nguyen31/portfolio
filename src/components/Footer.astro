---
import home from '../data/home.json';
const s = home.site;
const row = 'border-b border-[#3A3A42] pb-3.5 text-bg no-underline transition-colors hover:text-footer-accent';
---
<footer id="contact" class="bg-footer text-bg">
  <div class="wrap flex flex-col gap-12 pb-10 pt-16">
    <div class="flex flex-wrap items-end justify-between gap-12">
      <p class="m-0 flex-[1_1_560px] font-serif text-[clamp(44px,6vw,80px)] leading-none tracking-[-0.02em]" set:html={home.footer.heading.replace('<em>', '<em class="text-footer-accent">')} />
      <div class="flex flex-[0_1_340px] flex-col gap-3.5 font-mono text-sm">
        <a class={row} href={`mailto:${s.email}`}>Email · {s.email} ↗</a>
        <a class={row} href={s.linkedin} target="_blank" rel="noopener noreferrer">{s.linkedinLabel} ↗</a>
        {s.socials.map((l) => <a class={row} href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>)}
      </div>
    </div>
    <div class="flex flex-wrap justify-between gap-3 font-mono text-xs text-[#A3A3AD]">
      <span>{s.copyright}</span>
    </div>
  </div>
</footer>
