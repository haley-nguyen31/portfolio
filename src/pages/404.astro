---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Button from '../components/Button.astro';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <section class="dot-grid relative overflow-hidden border-b border-line">
    <div class="wrap flex min-h-[70vh] flex-col justify-center gap-6 py-24">
      <SectionLabel class="">ERROR 404</SectionLabel>
      <h1 class="h1 m-0 font-serif text-[clamp(64px,12vw,160px)] font-normal leading-[0.95] tracking-[-0.02em]">Page <em>not found</em>.</h1>
      <p class="m-0 max-w-[520px] text-lg leading-relaxed text-body">The page you are looking for moved or never existed. Try one of these instead.</p>
      <div class="flex flex-wrap gap-3">
        <Button href="/">Back home</Button>
        <Button href="/work" variant="ghost">See my work</Button>
      </div>
    </div>
  </section>
</Base>
